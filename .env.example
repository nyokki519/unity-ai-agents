# Never commit real values. Node 22+ can load a local file with --env-file.
UNITY_ADMIN_TOKEN=
UNITY_PORT=8787
# No OpenAI API key, provider key, existing Unity key, or paid service is needed.
# Local FileStore defaults. GitHub Actions and optional cloud console have separate settings.
# Optional for authenticated GitHub reads. Public repository reads also work without it.
# UNITY_GITHUB_TOKEN=
# Proxy environments on Node 24: start with --use-env-proxy; never unset the proxy.

# Cloudflare Worker settings (set in Worker dashboard, not committed):
# UNITY_PUBLIC_ORIGIN=https://unity-ai-agents.YOUR-SUBDOMAIN.workers.dev
# UNITY_FREE_CLOUD_CONFIRMED=false
# UNITY_ADMIN_TOKEN: Worker Secret, random 32+ characters
# CLOUDFLARE_API_TOKEN is deployment-only; never send to the browser or Worker.
