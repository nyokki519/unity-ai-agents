# Never commit real values. Node 22+ can load a local file with --env-file.
UNITY_ADMIN_TOKEN=
UNITY_PORT=8787
# No OpenAI API key, provider key, existing Unity key, or paid service is needed.
# Local execution only; hosting, GitHub connections and schedules are disabled.
# Optional for authenticated GitHub reads. Public repository reads also work without it.
# UNITY_GITHUB_TOKEN=
# Proxy environments on Node 24: start with --use-env-proxy; never unset the proxy.
