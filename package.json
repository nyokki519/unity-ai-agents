{
  "name": "unity-ai-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && node --check public/app.js",
    "test": "vitest run",
    "cloud:check": "wrangler deploy --dry-run --outdir .runtime/worker-build",
    "cloud:dev": "wrangler dev --local",
    "cloud:deploy": "wrangler deploy",
    "cloud:smoke": "node scripts/cloud-smoke.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniflare": "5.20261012.1-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "4.151.1"
  }
}
