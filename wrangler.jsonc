{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unity-ai-agents",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "CONSOLE", "class_name": "UnityConsole"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["UnityConsole"]}],
  "observability": {"enabled": false},
  "triggers": {"crons": ["40 22 * * *"]},
  "ai": {"binding": "AI"},
  "keep_vars": true
}
